# Anthropic API key (or run `ant auth login` and leave this unset)
ANTHROPIC_API_KEY=

# Claude model used for JD analysis, tailoring and the score explanation
CLAUDE_MODEL=claude-opus-5
# Server-side refusal fallbacks (1 = on, 0 = off)
CLAUDE_FALLBACKS=1
# Write the AI score explanation during tailoring (0 = on demand, saves one Claude call per run)
AUTO_EXPLAIN=0

# Path to tectonic.exe if it is not on PATH
TECTONIC_PATH=

# Term label used in the output filename: First_Last_Company_<TERM_LABEL>.pdf
TERM_LABEL=Spring2028

# Max share of resume words the tailoring may change (0.20 = 20%)
MAX_CHANGE_RATIO=0.20
# Max share of bullets that may be rewritten
MAX_BULLET_RATIO=0.50
# Tailored score the tailoring aims for (it retries up to TAILOR_ROUNDS times)
TARGET_SCORE=85
TAILOR_ROUNDS=3
# Max keywords added to the skills lines
MAX_SKILL_ADDS=15
# Graduation dates offered on the tailor page (sets the Education end date and the filename term)
GRAD_DATES=May 2028,May 2029
